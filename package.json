{
  "name": "musical-chairs",
  "version": "1.0.0",
  "description": "Hybrid-meeting musical chairs: one host screen, N player devices, skill-scramble minigames.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "security:assess": "node scripts/security-assessment.mjs",
    "graph": "graphify update . && node scripts/graph-lock.mjs",
    "graph:rebuild": "graphify extract . && node scripts/graph-lock.mjs",
    "graph:report": "graphify god-nodes --top 15",
    "graph:setup": "graphify install --project && graphify hook install"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "socket.io-client": "^4.7.5"
  },
  "license": "MIT"
}
