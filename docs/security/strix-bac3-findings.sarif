          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "server/sockets.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 41,
                        "endLine": 64
                      },
                      "insertedContent": {
                        "text": "function takeSourceToken(store, socket, name, limit, windowMs, { softCap = 10_000, trimTo = 8_000, hardCap = 12_000 } = {}) {\n  const now = Date.now();\n  const key = `${crypto.createHash('sha256').update(clientAddress(socket)).digest('hex')}:${name}`;\n  const recent = (store.get(key) || []).filter((at) => now - at < windowMs);\n  if (recent.length >= limit) {\n    store.set(key, recent);\n    return false;\n  }\n  recent.push(now);\n  store.set(key, recent);\n  // Bound the process-wide tracker even if many source addresses touch it.\n  // A hard cap (not just expired-entry cleanup) stops address churn from\n  // growing the map without limit.\n  if (store.size > softCap) {\n    for (const [address, attempts] of store) {\n      if (!attempts.some((at) => now - at < windowMs)) store.delete(address);\n      if (store.size <= trimTo) break;\n    }\n  }\n  if (store.size > hardCap) {\n    store.clear();\n  }\n  return true;\n}\n\nfunction failedJoinAllowed(failedJoins, socket) {\n  return takeSourceToken(failedJoins, socket, 'failed-join', 30, 60_000);\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "server/sockets.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 93,
                        "endLine": 97
                      },
                      "insertedContent": {
                        "text": "export function attachSockets(io, { allowClientScoredCompetitive = false, allowInternalCreateConfig = false } = {}) {\n  const rooms = new Map();\n  // Shared across sockets for this server instance so reconnecting does not\n  // reset a source's failed-code budget; isolated across test/server instances.\n  const failedJoins = new Map();\n  // Anonymous room creation must be budgeted per source address, not per\n  // transport, or a client can reconnect to mint an unlimited number of rooms.\n  const createAttempts = new Map();"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "server/sockets.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 123,
                        "endLine": 149
                      },
                      "insertedContent": {
                        "text": "socket.on('host:create', guarded(socket, 'host:create', { limit: 3, ack: true }, async (payload, cb) => {\n      if (typeof cb !== 'function') return;\n      try {\n        if (!takeSourceToken(createAttempts, socket, 'room:create', 6, 60_000)) {\n          return cb({ error: 'Too many rooms created from this address — try again shortly.' });\n        }\n        let code;\n        do { code = makeRoomCode(); } while (rooms.has(code));\n        const requestedConfig = allowInternalCreateConfig ? (payload?.config || {}) : pickHostEditableConfig(payload?.config);\n        const r = new Room(io, code, requestedConfig, destroyRoom, { allowClientScoredCompetitive });\n        rooms.set(code, r);\n        const previousCode = socket.data.roomCode;\n        if (previousCode && previousCode !== code) detachFromRoom(previousCode);\n        r.hostSocketId = socket.id;\n        socket.join(`room:${code}`);\n        socket.join(`host:${code}`);\n        socket.data.roomCode = code;\n        socket.data.isHost = true;\n        socket.data.playerId = null;\n        const joinUrl = `${publicOrigin(socket)}/?code=${code}`;\n        let qr = null;\n        try {\n          qr = await QRCode.toDataURL(joinUrl, { margin: 1, width: 480 });\n        } catch { /* QR is decorative — never block room creation on it */ }\n        cb({ ok: true, code, hostKey: r.hostKey, joinUrl, qr, config: r.publicConfig() });\n      } catch (err) {\n        console.error('host:create', err);\n        cb({ error: 'Could not create room.' });\n      }\n    }));"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "server/sockets.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 215,
                        "endLine": 229
                      },
                      "insertedContent": {
                        "text": "socket.on('solo:create', guarded(socket, 'solo:create', { limit: 3, ack: true }, ({ name } = {}, cb) => {\n      if (typeof cb !== 'function') return;\n      if (!takeSourceToken(createAttempts, socket, 'room:create', 6, 60_000)) {\n        return cb({ error: 'Too many rooms created from this address — try again shortly.' });\n      }\n      let code;\n      do { code = makeRoomCode(); } while (rooms.has(code));\n      const r = new Room(io, code, {}, destroyRoom, { allowClientScoredCompetitive });\n      r.solo = true;\n      rooms.set(code, r);\n      const previousCode = socket.data.roomCode;\n      if (previousCode && previousCode !== code) detachFromRoom(previousCode);\n      const joined = r.join(socket, { name });\n      // The creator is the solo owner: only this player may drive the room\n      // (Strix re-scan 2026-08-23: solo-room takeover).\n      if (joined.ok) r.soloOwnerId = joined.playerId;\n      cb(joined);\n    }));"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "server/room.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 439,
                        "endLine": 447
                      },
                      "insertedContent": {
                        "text": "handleDisconnect(socket) {\n    if (socket.id === this.hostSocketId) this.hostSocketId = null;\n    const changed = this.disconnectSocketPlayers(socket.id);\n    if (changed) this.broadcastPlayers();\n    const anyConnected =\n      this.hostSocketId || [...this.players.values()].some((p) => p.connected);\n    if (!anyConnected) {\n      const emptyTtlMs = this.phase === 'lobby'\n        ? (this.solo ? 30_000 : 60_000)\n        : 15 * 60 * 1000;\n      this.setTimer('empty', () => this.onEmpty(this), emptyTtlMs);\n    }\n  }"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "1. Enforce anonymous room-creation quotas with a process-wide source key derived from the server-observed client address, rather than from `socket.data`, so reconnecting or opening parallel transports does not reset the budget.\n2. Share the quota across both `host:create` and `solo:create`, and bound the backing tracker with expiry and hard caps so the mitigation does not itself become an unbounded map.\n3. Shorten eviction for empty never-started rooms, especially solo and lobby-only rooms, so disconnecting immediately after creation does not reserve memory for fifteen minutes.\n4. Keep the longer reconnect grace only for rooms that have already started or still contain connected participants, and reject or tear down room creation bursts before allocating full room state.",
                "markdown": "1. Enforce anonymous room-creation quotas with a process-wide source key derived from the server-observed client address, rather than from `socket.data`, so reconnecting or opening parallel transports does not reset the budget.\n2. Share the quota across both `host:create` and `solo:create`, and bound the backing tracker with expiry and hard caps so the mitigation does not itself become an unbounded map.\n3. Shorten eviction for empty never-started rooms, especially solo and lobby-only rooms, so disconnecting immediately after creation does not reserve memory for fifteen minutes.\n4. Keep the longer reconnect grace only for rooms that have already started or still contain connected participants, and reject or tear down room creation bursts before allocating full room state."
              }
            }
