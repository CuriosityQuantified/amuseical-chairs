node_modules/
npm-debug.log*
.DS_Store

# graphify: the three artifacts in graphify-out/ are committed on purpose —
# graph.json is what `graphify query` reads, so a fresh clone can query the
# codebase without rebuilding it. Everything below is either machine-specific
# or regenerable, and rebuilds on the next `graphify update .`.
graphify-out/.graphify_root
graphify-out/.graphify_analysis.json
graphify-out/.graphify_semantic_marker
graphify-out/manifest.json
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
# Dated backups graphify writes before it overwrites a curated graph.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify's PreToolUse hooks embed the absolute path of the interpreter that
# installed them, so they are per-machine by design. Run `graphify install
# --project` to write your own; the skill itself is committed.
.claude/settings.local.json
