node_modules/
npm-debug.log*
.DS_Store

# graphify: graph.json, graph.html, GRAPH_REPORT.md and graph-lock.json are
# committed on purpose — graph.json is what `graphify query` reads, so a fresh
# clone can query the codebase without rebuilding it, and graph-lock.json is how
# `npm run check` knows the graph still matches the code. Everything below is
# either machine-specific or regenerable, and rebuilds on the next
# `graphify update .`.
graphify-out/.graphify_root
graphify-out/.graphify_analysis.json
graphify-out/.graphify_semantic_marker
# The manifest carries per-file mtimes, which are checkout time on a fresh clone:
# committing it would make every machine's first rebuild rewrite all 40 entries.
# scripts/graph-lock.mjs distils the part that matters into graph-lock.json.
graphify-out/manifest.json
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
# Dated backups graphify writes before it overwrites a curated graph.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify's PreToolUse hooks embed the absolute path of the interpreter that
# installed them, so they are per-machine by design. Run `graphify install
# --project` to write your own; the skill itself is committed.
.claude/settings.local.json
